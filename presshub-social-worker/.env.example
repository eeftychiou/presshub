# PressHub WordPress Base URL for Pull Mode polling
PRESSHUB_WP_URL=https://presshub.cy

# Shared secret key matching WordPress Settings -> Social Auto-Post -> Worker Secret
PRESSHUB_WORKER_SECRET=your-secret-here

# Worker service HTTP listening port (default: 3456)
PRESSHUB_WORKER_PORT=3456

# Pull Mode polling interval in milliseconds (default: 30000ms / 30 seconds)
PRESSHUB_POLL_INTERVAL_MS=30000

# Browser automation headless mode (false for visible Chrome window to avoid detection; true for headless/CI)
PRESSHUB_HEADLESS=false

# Dedicated worker log file destination (default: logs/worker.log)
PRESSHUB_LOG_FILE=logs/worker.log

# Worker log level (DEBUG, INFO, WARN, ERROR; default: DEBUG)
PRESSHUB_LOG_LEVEL=DEBUG

# --- Social Monitor (reads X and TikTok accounts listed as News Sources) ---
# WordPress decides when to scan (Settings -> Daily Briefing -> Social media monitoring).
# Set to true to stop this worker from scanning.
PRESSHUB_MONITOR_DISABLED=false

# --- Trending in Cyprus roundup (X search, TikTok search, Facebook Pages) ---
# WordPress decides when to refresh (Settings -> Daily Briefing -> Trending in Cyprus).
# Set to true to stop this worker from reading them.
PRESSHUB_TRENDING_DISABLED=false

# Folder with the reader account sessions (default: sessions-reader next to sessions).
# Create them with: npm run login -- twitter --reader   /   npm run login -- tiktok --reader
# PRESSHUB_MONITOR_SESSIONS_DIR=

# Use the posting account to browse when no reader session exists (not recommended).
PRESSHUB_MONITOR_ALLOW_POSTING_SESSION=false
